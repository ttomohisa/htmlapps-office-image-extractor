{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "app-config.schema.json",
  "type": "object",
  "required": ["name", "nameJa", "slug", "version", "build"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "nameJa": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "descriptionJa": {"type": "string"},
    "defaultLanguage": {"enum": ["auto", "ja", "en"]},
    "repository": {
      "type": "object",
      "properties": {"owner": {"type": "string"}, "name": {"type": "string"}},
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "required": ["output", "blockRuntimeNetwork"],
      "properties": {
        "output": {"type": "string", "minLength": 1},
        "blockRuntimeNetwork": {"type": "boolean"},
        "selfExtract": {
          "type": "object",
          "required": ["enabled", "output"],
          "properties": {"enabled": {"type": "boolean"}, "output": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
